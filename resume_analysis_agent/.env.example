# ====================================================
# Resume Analysis Agent — Environment Configuration
# ====================================================

# Google Gemini API key (recommended for production evaluation)
GEMINI_API_KEY=your_gemini_api_key_here

# Default model to use (gemini-2.5-flash, gemini-2.5-pro, or local Ollama)
DEFAULT_MODEL=gemini-2.5-flash

# GitHub Token (optional, raises GitHub API rate limit from 60 to 5,000 req/hr)
GITHUB_TOKEN=

# Microservice API configuration
AGENT_HOST=0.0.0.0
AGENT_PORT=8001
DEBUG=true
